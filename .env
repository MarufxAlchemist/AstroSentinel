# ── Docker-specific variables ─────────────────────────────────────────────────
# These are ONLY used by docker-compose.yml.
# The non-Docker services (run-commands.txt) use DATABASE_URL above directly.

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Maruf@788824
# URL-encoded version of the password (@ → %40) for use inside DATABASE_URL
POSTGRES_PASSWORD_URLENC=Maruf%40788824
POSTGRES_DB=Astro-sentinel