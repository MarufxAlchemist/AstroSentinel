# Python virtual environment — never copy into container
venv/
.venv/
env/

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Test files
test_*.py
*_test.py

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Large data files not needed at runtime
historical_events_2026.json

# Git
.git
.gitignore

# Secrets — injected via docker-compose env_file
.env
