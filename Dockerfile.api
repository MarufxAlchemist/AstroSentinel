# syntax=docker/dockerfile:1
##############################################################################
# Dockerfile.api — Express + WebSocket + Drizzle ORM API server
#
# BUILD CONTEXT: repo root  (required for pnpm workspace resolution)
#
# Multi-stage build:
#   builder → pnpm install + esbuild bundle
#   runner  → minimal runtime image (dist + native node_modules only)
#
# Optimizations:
#   • BuildKit pnpm store cache — dramatically faster re-installs
#   • runner has no corepack/pnpm — just node + the bundle
#   • Layer ordering: manifests → install → source → build
##############################################################################

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:22-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# ── Workspace manifests (cached layer) ────────────────────────────────────────
# These rarely change — Docker caches the install layer until any manifest changes.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# tsconfig.base.json is extended by lib/* and artifacts/*/tsconfig.json files.
# Must be available before the build step so TypeScript can resolve the chain.
COPY tsconfig.base.json ./

COPY lib/db/package.json                    ./lib/db/package.json
COPY lib/api-zod/package.json               ./lib/api-zod/package.json
COPY lib/api-spec/package.json              ./lib/api-spec/package.json
COPY lib/api-client-react/package.json      ./lib/api-client-react/package.json
COPY artifacts/api-server/package.json      ./artifacts/api-server/package.json
COPY artifacts/astro-sentinel/package.json  ./artifacts/astro-sentinel/package.json
COPY scripts/package.json                   ./scripts/package.json

# ── Install with BuildKit pnpm store cache ────────────────────────────────────
# The cache mount persists the pnpm content-addressable store between builds.
# On a source-only change, pnpm links from cache instead of downloading.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ── Source code ───────────────────────────────────────────────────────────────
COPY lib/              ./lib/
COPY artifacts/api-server/ ./artifacts/api-server/

# ── Build (esbuild → dist/index.mjs) ─────────────────────────────────────────
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM node:22-slim AS runner

WORKDIR /app

# ── Copy esbuild output ───────────────────────────────────────────────────────
COPY --from=builder /workspace/artifacts/api-server/dist/ ./dist/

# ── Copy node_modules for externalized native packages ───────────────────────
# esbuild externalizes: bcrypt (native), bufferutil, utf-8-validate, etc.
# These require node_modules to be present at runtime.
COPY --from=builder /workspace/node_modules/ ./node_modules/

# ── Bootstrap seed data ──────────────────────────────────────────────────────
# bootstrap.ts resolves: path.resolve(import.meta.dirname, "..", "recent_events.json")
# import.meta.dirname = /app/dist/  →  ".." = /app/  →  file at /app/recent_events.json
COPY artifacts/api-server/recent_events.json ./recent_events.json

# ── Port ─────────────────────────────────────────────────────────────────────
EXPOSE 8000

# ── Runtime ──────────────────────────────────────────────────────────────────
# --enable-source-maps: human-readable stack traces from bundled .mjs
# All env vars (PORT, DATABASE_URL, etc.) injected by docker-compose at runtime.
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
