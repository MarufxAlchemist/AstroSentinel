# ============================================================================
# .env.example — AstroSentinel / Cosmic Alert System
# ============================================================================
# Copy this file to .env and fill in real values before running Docker.
#
#   cp .env.example .env
#
# .env is gitignored — never commit the real file.
# This template is safe to commit (contains no real secrets).
#
# Quick start:
#   1. cp .env.example .env
#   2. Fill in all CHANGE_ME values
#   3. docker compose up --build
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by: postgres container, api-server, migrate service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# URL-encoded form of POSTGRES_PASSWORD — replace @ with %40, # with %23, etc.
# Example: if password is "my@pass#1", set this to "my%40pass%231"
POSTGRES_PASSWORD_URLENC=CHANGE_ME
POSTGRES_DB=Astro-sentinel

# Used for local (non-Docker) development only — Docker compose builds
# DATABASE_URL from POSTGRES_USER / POSTGRES_PASSWORD_URLENC / POSTGRES_DB above.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/Astro-sentinel

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ── ORCID OAuth ──────────────────────────────────────────────────────────────
ORCID_CLIENT_ID=APP-CHANGE_ME
ORCID_CLIENT_SECRET=CHANGE_ME
VITE_ORCID_CLIENT_ID=APP-CHANGE_ME

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# ── GCN Kafka Credentials (NASA General Coordinates Network) ──────────────────
# Obtain at: https://gcn.nasa.gov/quickstart
# Used by: python-backend (GCN Kafka consumer)
GCN_CLIENT_ID=CHANGE_ME
GCN_CLIENT_SECRET=CHANGE_ME
